# ---------------------------------------------------------------------------
# Variáveis consumidas pelo docker-compose.yml e repassadas ao container do
# backend via `env_file`. Copie este arquivo para ".env" antes de rodar
# `docker compose up`. Nenhum valor aqui é um segredo real.
# ---------------------------------------------------------------------------

APP_NAME=AtendSaude
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# DB_HOST usa o nome do serviço no docker-compose ("db"), não localhost.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=atendsaude
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Consumida pelo Vite dentro do container "frontend"
VITE_API_BASE_URL=http://localhost:8000/api/v1
